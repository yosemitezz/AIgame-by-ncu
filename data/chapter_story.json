  "lines": {
    "OPEN_MEMORY": {
      "speaker": "旅人",
      "text": "头好疼……这身甲，是谁的？"
    },
    "OPEN_EYE": {
      "speaker": "飞眼",
      "text": "喂，盔甲里那位。别盯门了——门后没写你的名字。"
    },
    "OPEN_TRUST": {
      "speaker": "飞眼",
      "text": "名字晚点再想。先站稳——前面那位，可不等你自我介绍。"
    },
    "T_MOVE": {
      "speaker": "飞眼",
      "text": "很好，腿没丢。盯住敌人的肩——它动之前，刃先动。"
    },
    "T_JUMP": {
      "speaker": "飞眼",
      "text": "跳得不错。空中再借一把力——铁链可不长眼。"
    },
    "T_DODGE": {
      "speaker": "飞眼",
      "text": "同方向快按两次，闪开再回来。别光往后躲——后头路也不长。"
    },
    "T_HIT": {
      "speaker": "飞眼",
      "text": "打中了。J 接着按能连三段；最后一下，记得给自己留收势。"
    },
    "T_PARRY": {
      "speaker": "飞眼",
      "text": "对，就是左 Shift 碰实的那一下。响声脆，说明没拿脸接。"
    },
    "T_WEAPON": {
      "speaker": "飞眼",
      "text": "1、2、3 直接选，Q/K 轮换。刀不同，距离和收势也不同。"
    },
    "T_CLIMB": {
      "speaker": "飞眼",
      "text": "W/S 抓稳上下爬。出刀就松手——先看清落脚处，再动刀。"
    },
    "T_DOOR": {
      "speaker": "飞眼",
      "text": "门也有讲道理的时候。靠近按 E，记得留条回来的路。"
    },
    "T_CHECKPOINT": {
      "speaker": "飞眼",
      "text": "这盏灯记得你。倒下了就回来——路，不用再认第二遍。"
    },
    "T_FIRST_KILL": {
      "speaker": "飞眼",
      "text": "手稳了。不错——你的影子，也稳了。"
    },
    "T_GROWTH": {
      "speaker": "飞眼",
      "text": "你看，比刚才顺手多了。别停——千万别停。"
    },
    "T_ELITE": {
      "speaker": "飞眼",
      "text": "拦路的倒了。喘口气——前头的门，现在肯听话了。"
    },
    "F_ELITE": {
      "speaker": "飞眼",
      "text": "门开了。你越强，我越省事——继续。"
    },
    "T_BOSS": {
      "speaker": "飞眼",
      "text": "这回看她的刀柄。能接的用左 Shift 迎上去，接不了就先躲。"
    },
    "F_BOSS": {
      "speaker": "飞眼",
      "text": "别怕，往死里打。你越强……我就越放心。"
    },
    "RESCUE_CALL": {
      "speaker": "飞眼",
      "text": "喂，别闭眼——看着我。"
    },
    "RESCUE_RESTORE": {
      "speaker": "飞眼",
      "text": "还能站起来。先把气喘匀——别急着送第二次。"
    },
    "RESCUE_SHOCK": {
      "speaker": "",
      "text": "她没有补刀。你再次握剑扑上去，她露出诧异又痛苦的神情。"
    },
    "WIN_ASSIST": {
      "speaker": "飞眼",
      "text": "赢了就站稳。别急着倒——我可没打算抬人。"
    },
    "WIN_FATIGUE": {
      "speaker": "旅人",
      "text": "赢了……可这身子，怎么越来越重。"
    },
    "WIN_EYE": {
      "speaker": "飞眼",
      "text": "够了。站着，别动。"
    },
    "BETRAY_MOCK": {
      "speaker": "飞眼",
      "text": "刀不错。人，更听话。"
    },
    "DEATH_NARRATIVE": {
      "speaker": "",
      "text": "你死亡"
    }
  },
