extends SceneTree
## Pure branch/state fixtures. No actor, music playback or game input.
const Story = preload("res://flow/chapter_story.gd")
var passed: int = 0
var failed: int = 0
func check(ok: bool, label: String) -> void:
    if ok: passed += 1
    else: failed += 1; push_error("FAIL " + label)
func count(commands: Array[Dictionary], kind: String) -> int:
    var total: int = 0
    for command: Dictionary in commands:
        if command["command"] == kind: total += 1
    return total
func fresh() -> RefCounted: return Story.new()
func explore() -> RefCounted:
    var story = fresh()
    story.begin_chapter(); story.skip(); story.take_commands()
    return story
func reach(story: RefCounted, node_id: String) -> bool:
    for step: int in 2000:
        if story.presentation()["node_id"] == node_id: return true
        if not story.is_blocking(): return false
        story.tick(0.05)
    return false
func _initialize() -> void:
    var story = fresh()
    check(story.validate_data().is_empty(), "all localized lines and finite graph branches resolve")
    check(story.corruption == 0 and not story.chapter_complete and not story.rescue_used, "clean amnesiac chapter starts without corruption or rescue flags")
    check(story.begin_chapter() and story.is_blocking() and story.phase == "opening", "opening is an explicit short blocking scene")
    check(story.presentation()["speaker"] == "旅人", "hero speaks under the HUD traveler label instead of a second-person tag")
    var commands: Array[Dictionary] = story.take_commands()
    check(count(commands,"narrative_lock") == 1 and commands[0]["data"]["pause_music"] and commands[0]["data"]["clear_attacks"], "opening requests root safety and clock pause")
    check(not story.begin_chapter() and not story.event("jump"), "opening cannot reenter or consume actual-action tutorials")
    check(not story.advance(), "one input edge cannot immediately consume a fresh line")
    story.tick(0.3)
    check(story.advance() and story.presentation()["line_id"] == "OPEN_EYE", "continue advances to the embodied eye")
    var at: float = story.presentation()["node_elapsed"]
    story.tick(5,true)
    check(story.presentation()["node_elapsed"] == at and not story.advance() and not story.skip(), "pause freezes narrative and rejects advance/skip")
    story.tick(0,false,true)
    check(not story.skip() and story.presentation()["node_elapsed"] == at, "transport lock freezes narrative cursor")
    story.tick(0,false,false)
    check(story.skip() and story.phase == "explore" and not story.is_blocking(), "skip opening reaches live exploration")
    check(count(story.take_commands(),"narrative_unlock") == 1 and not story.begin_chapter(), "opening releases exactly once and never replays on retry")
    story = explore()
    check(story.event("move") and not story.is_blocking() and story.presentation()["line_id"] == "T_MOVE", "real movement triggers a nonblocking trustworthy bark")
    check(not story.event("move"), "shown tutorial cannot spam")
    check(story.event("jump") and not story.event("air_jumped"), "jump and air-jump share a queued once-only tutorial")
    check(story.event("dodge") and story.event("attack") and story.event("weapon_changed"), "different actual operations queue independently")
    check(not story.event("parry") and not story.snapshot()["seen"].has("tutorial:T_PARRY"), "full queue does not consume the actual parry tutorial")
    story.tick(4)
    check(story.event("parry"), "after a queue slot opens a later real parry can still trigger teaching")
    var saved: Dictionary = story.prepare_retry()
    var restored = fresh(); restored.configure(saved)
    check(not restored.event("move") and not restored.event("jump"), "death retry retains tutorials actually shown")
    check(restored.event("parry"), "a queued but never shown tutorial is not lost across retry")
    story = explore()
    check(not story.event("enemy_defeated",{"kind":"sentry"}), "kill event requires stable authored identity")
    check(story.event("enemy_defeated",{"id":"dungeon:sentry:1","kind":"sentry"}), "first unique kill adds subtle corruption")
    check(is_equal_approx(story.corruption,0.045) and story.kill_count == 1, "first dark trace is small")
    check(not story.event("enemy_defeated",{"id":"dungeon:sentry:1","kind":"sentry"}) and story.kill_count == 1, "one death cannot farm corruption twice")
    for index: int in range(1,20): story.event("enemy_defeated",{"id":"authored:"+str(index),"kind":"sentry"})
    check(is_equal_approx(story.corruption,0.62) and story.kill_count == 20, "before Boss corruption grows but stays capped")
    restored = fresh(); restored.configure(story.prepare_retry())
    check(restored.kill_count == 20 and not restored.event("enemy_defeated",{"id":"authored:1"}), "kill identities survive retry and cannot be farmed")
    check(not story.can_rescue(false,true) and not story.can_rescue(true,false), "ordinary rooms and nonlethal hits do not force rescue")
    check(not story.request_rescue({"in_boss":true}), "caller must explicitly identify a genuine lethal event")
    check(story.request_rescue({"in_boss":true,"lethal":true}), "first genuine Boss lethal event starts rescue instead of combat defeat")
    check(story.rescue_used and story.is_blocking() and story.phase == "rescue", "rescue is reserved immediately once")
    commands = story.take_commands()
    check(count(commands,"narrative_lock") == 1 and count(commands,"rescue_restore") == 0, "rescue initially clears attacks without premature reward")
    check(reach(story,"rescue_restore"), "user-original rescue graph reaches the restore node")
    story.tick(0.1)
    commands = story.take_commands()
    check(count(commands,"rescue_restore") == 1 and story.presentation()["eye_mood"] == "concerned", "eye actually restores once after the dizzy blackout")
    check(story.skip(), "rescue can be skipped after its heal")
    commands = story.take_commands()
    check(count(commands,"rescue_restore") == 0 and count(commands,"boss_shock") == 1 and count(commands,"narrative_unlock") == 1, "skip preserves Boss shock and unlock without double-heal")
    check(not story.request_rescue({"in_boss":true,"lethal":true}), "a later lethal contact is ordinary combat failure")
    restored = fresh(); restored.configure(story.snapshot()); restored.synchronize_commands(); restored.synchronize_commands()
    check(restored.rescue_used and count(restored.take_commands(),"rescue_restore") == 0, "restoring consumed rescue never awards it again")
    story = explore(); story.request_rescue({"in_boss":true,"lethal":true}); story.take_commands(); story.skip()
    commands = story.take_commands()
    check(count(commands,"rescue_restore") == 1 and count(commands,"boss_shock") == 1 and count(commands,"narrative_unlock") == 1, "skipping before rescue heal still reaches a complete recoverable state")
    story.tick(100)
    check(story.take_commands().is_empty(), "finished rescue cannot repeat commands on a long frame")
    story = explore(); story.tick(0,true)
    check(not story.request_rescue({"in_boss":true,"lethal":true}) and not story.event("attack"), "paused gameplay cannot begin rescue or consume tutorial events")
    story.tick(0,false,true)
    check(not story.request_rescue({"in_boss":true,"lethal":true}), "portal transport cannot begin rescue")
    story = explore()
    check(story.boss_defeated() and story.chapter_complete and story.corruption == 1.0, "Boss victory is recorded before any narrative death")
    check(story.presentation()["scene_id"] == "ending_assisted" and not story.rescue_used, "direct first victory uses weakness alternative without forcing a losing fight")
    commands = story.take_commands()
    check(count(commands,"chapter_complete") == 1 and count(commands,"narrative_lock") == 1, "victory completion and safety have one authority")
    check(reach(story,"betray_eye"), "earned-victory fatigue and ambush graph reaches cold reversal")
    check(story.phase == "betrayal" and story.presentation()["eye_mood"] == "cold", "aftermath proceeds to the eye's cold reversal")
    check(story.skip() and story.narrative_dead and story.chapter_complete, "skip ending preserves won chapter and reaches narrative death")
    var view: Dictionary = story.presentation()
    check(view["bloodred"] and view["line"] == "你死亡" and view["blackout"] == 1.0, "ending death is specifically red on black, separate from ordinary defeat")
    commands = story.take_commands()
    check(count(commands,"narrative_death") == 1 and count(commands,"narrative_unlock") == 0, "narrative death keeps completed combat safely locked")
    story.tick(1.5)
    check(is_equal_approx(story.presentation()["death_elapsed"],1.5), "blood reveal has a real pausable terminal cursor")
    story.tick(10,true)
    check(is_equal_approx(story.presentation()["death_elapsed"],1.5), "pause cannot advance blood drips")
    story.tick(0,false)
    check(not story.boss_defeated() and not story.event("enemy_defeated",{"id":"late"}), "finished chapter cannot duplicate victory or late kill rewards")
    check(story.replay_ending() and story.chapter_complete and not story.narrative_dead, "ending replay is allowed without revoking victory")
    commands = story.take_commands()
    check(count(commands,"chapter_complete") == 0 and count(commands,"rescue_restore") == 0, "replay cannot repeat gameplay rewards")
    story.tick(100)
    check(story.narrative_dead and story.chapter_complete, "a long replay frame reaches a valid terminal state")
    check(count(story.take_commands(),"narrative_death") == 1, "replayed terminal presentation emits once per replay")
    restored = fresh(); restored.configure(story.snapshot()); restored.synchronize_commands(); restored.synchronize_commands()
    commands = restored.take_commands()
    check(restored.narrative_dead and restored.chapter_complete and count(commands,"narrative_lock") == 1, "restored ending synchronizes safety once without replaying death logic")
    check(restored.dismiss_completed() and not restored.narrative_dead and restored.phase == "explore", "completed ending can dismiss back to exploration")
    check(restored.chapter_complete and restored.ending_seen and restored.corruption == 1.0, "dismiss keeps victory, watched ending and corruption")
    check(count(restored.take_commands(),"narrative_unlock") == 1 and not restored.dismiss_completed(), "dismiss safety unlock is once-only")
    var dismissed = fresh(); dismissed.configure(restored.snapshot())
    check(dismissed.ending_dismissed and not dismissed.narrative_dead and not dismissed.is_blocking(), "reload cannot resurrect an already dismissed red death screen")
    var retry_dismissed = fresh(); retry_dismissed.configure(restored.prepare_retry())
    check(retry_dismissed.ending_dismissed and not retry_dismissed.narrative_dead, "completed retry respects dismissal")
    check(restored.replay_ending() and not restored.ending_dismissed and restored.chapter_complete, "replay reopens presentation without revoking completed chapter")
    restored.take_commands(); restored.skip()
    check(restored.narrative_dead and restored.dismiss_completed(), "replayed ending can dismiss again")
    check(count(restored.take_commands(),"rescue_restore") == 0, "replay and dismissal cannot repeat a heal")
    story = explore(); story.set_rescue_policy("lethal_only"); story.boss_defeated()
    check(story.presentation()["scene_id"] == "ending" and not story.rescue_used, "alternative policy skips victory-assist scene but never erases success")
    check(not story.set_rescue_policy("force_loss") and story.rescue_policy == "lethal_only", "unsupported forced-failure policy is rejected")
    story = explore(); story.request_rescue({"in_boss":true,"lethal":true}); story.tick(1.4)
    saved = story.snapshot(); restored = fresh(); restored.configure(saved); restored.synchronize_commands()
    check(restored.is_blocking() and restored.presentation()["node_id"] == story.presentation()["node_id"] and restored.presentation()["node_elapsed"] == story.presentation()["node_elapsed"], "save/resume retains exact safe rescue cursor")
    check(count(restored.take_commands(),"narrative_lock") == 1, "restored blocking scene requests root safety rather than reapplying rewards")
    restored.tick(100)
    check(not restored.is_blocking() and restored.rescue_used, "restored rescue terminates safely")
    check(not restored.restore({"version":99}) and restored.rescue_used, "unknown snapshot cannot wipe existing progress")
    story = fresh(); check(not story.rescue_used and not story.chapter_complete and story.corruption == 0, "new chapter is a distinct clean run")
    story = explore()
    story.event("enemy_defeated",{"id":"authored:first","kind":"sentry"}); story.tick(4.0)
    check(story.event("enemy_defeated",{"id":"authored:elite","kind":"elite"}) and story.presentation()["line_id"] == "T_ELITE", "elite kill starts its reliable tutorial")
    story.tick(4.0)
    check(story.presentation()["line_id"] == "F_ELITE" and str(story.presentation()["line"]).contains("省事"), "elite follow-up sounds like praise while seeding the eye's use")
    story = explore()
    check(story.event("boss_entered") and story.presentation()["line_id"] == "T_BOSS", "Boss entry teaches the parryable silhouette first")
    story.tick(4.0)
    check(story.presentation()["line_id"] == "F_BOSS" and str(story.presentation()["line"]).contains("放心"), "Boss follow-up keeps the encouragement double-edged")
    check(not str(story.data["lines"]["WIN_ASSIST"]["text"]).contains("连剑") and str(story.data["lines"]["WIN_FATIGUE"]["speaker"]) == "旅人", "victory assist fits a healthy winner and keeps the traveler label")
    var story_text: String = FileAccess.get_file_as_string("res://data/chapter_story.json")
    var no_added_canon: bool = true
    for removed: String in ["将军","五年前","旧友","钥匙","帝国","VESSEL","宿主"]: no_added_canon = no_added_canon and not story_text.contains(removed)
    check(no_added_canon and not story.data.has("background_canon"), "latest user direction removes withdrawn friend backstory from runtime data")
    var allowed: Array[String] = ["opening","explore","rescue","aftermath","betrayal","narrative_dead"]
    var phases_valid: bool = true
    for node: Dictionary in story.data["nodes"].values(): phases_valid = phases_valid and str(node["phase"]) in allowed
    check(phases_valid, "chapter schedules only original opening/rescue/earned-win ambush phases")
    check(str(story.data["lines"]["BETRAY_MOCK"]["text"]) == "刀不错。人，更听话。", "ending uses a short replaceable cold mockery draft")
    story = explore(); story.request_rescue({"in_boss":true,"lethal":true}); story.take_commands()
    check(story.presentation()["node_id"] == "rescue_fall" and not story.presentation()["thread_pull"], "first genuine defeat shows dizzy abandonment without inventing thread extraction")
    check(reach(story,"rescue_call") and str(story.presentation()["line"]).contains("看着我"), "the embodied eye actually calls the hero back")
    check(reach(story,"rescue_restore"), "original rescue reaches its one restore")
    story.tick(.5)
    check(not story.presentation()["body_controlled"] and float(story.presentation()["fusion_progress"]) == 0.0, "rescue does not assert completed possession")
    check(reach(story,"rescue_shock") and str(story.presentation()["line"]).contains("诧异又痛苦"), "returning hero visibly surprises and pains the Boss")
    story = explore(); story.boss_defeated(); story.take_commands()
    check(story.chapter_complete and story.corruption == 1.0 and story.phase == "aftermath", "earned victory precedes fatigue and heavy ominous aura")
    check(reach(story,"betray_blackout"), "sudden post-victory ambush leads to blackout")
    check(not story.presentation()["body_controlled"] and float(story.presentation()["fusion_progress"]) == 0.0, "ambush leaves the betrayal mechanism unstated")
    check(reach(story,"betray_eye") and story.presentation()["eye_mood"] == "cold", "last visible eye is cold and mocks instead of reassuring")
    check(reach(story,"betray_beat") and float(story.presentation()["faint"]) == 0.0, "final beat keeps the last sight visible before it dims")
    story.tick(.9)
    var faint_mid: float = float(story.presentation()["faint"])
    check(faint_mid > 0.0 and faint_mid < 1.0, "closing vision darkens gradually like fainting")
    story.skip(); view = story.presentation()
    check(view["death_title"] == "你死亡" and view["bloodred"] and view["completion_label"] == "" and not view["vessel_complete"], "final red death has flowing-blood state without an unapproved vessel-completion reveal")
    check(story.chapter_complete and not story.rescue_used, "direct winner never has to lose to receive the ending")
    var rejected: String = "我教你防住了所有敌人，是你自己没把我算进去"
    check(not FileAccess.get_file_as_string("res://data/chapter_story.json").contains(rejected), "rejected mockery never enters runtime text")
    print("Chapter story: %d passed, %d failed" % [passed,failed])
    quit(1 if failed else 0)